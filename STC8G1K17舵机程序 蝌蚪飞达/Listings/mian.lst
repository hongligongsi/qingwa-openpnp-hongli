   1          /***************   STC8G1K17A 50Hz SG90舵机控制  ******************/
   2          #include <STC8G.H>
   3          #include <intrins.h>
   4          
   5          // IO定义
   6          sbit K1 = P3^2;           // 按键
   7          sbit PWM_OUT  = P3^3;    // 舵机PWM输出
   8          //=====??1:??LED??P5.4=====
   9          sbit SERVO_LED = P5^4;
  10          // 全局变量
  11          unsigned int count = 0;
  12          unsigned char servo_cnt = 10;  // 上电默认0°
  13          bit servo_running = 0;  // 舵机动作标志
  14          /*==================== 延时函数 @11.0592MHz ====================*/
  15          void Delay200ms(void) //@11.0592MHz
  16          {
  17   1        unsigned char data i, j, k;
  18   1      
  19   1        i = 12;
  20   1        j = 57;
  21   1        k = 122;
  22   1        do
  23   1        {
  24   2          do
  25   2          {
  26   3            while (--k);
  27   3          } while (--j);
  28   2        } while (--i);
  29   1      }
  30          
  31          void delay_20ms(void)
  32          {
  33   1        unsigned char i, j;
  34   1        i = 216;
  35   1        j = 37;
  36   1        do{ while (--j); } while (--i);
  37   1      }
  38          
  39          void delay_500ms(void)  //@11.0592MHz
  40          {
  41   1        unsigned char data i, j, k;
  42   1      
  43   1        i = 29;
  44   1        j = 14;
  45   1        k = 54;
  46   1        do
  47   1        {
  48   2          do
  49   2          {
  50   3            while (--k);
  51   3          } while (--j);
  52   2        } while (--i);
  53   1      }
  54          
